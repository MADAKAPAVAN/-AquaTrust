cff-version: 1.2.0
title: "AquaTrust: Calibrated Reliability and Conformal Risk Control for Side-Scan Sonar Object Detection"
message: "If you use this software, code, figures, or results in your research, please cite this repository."
type: software

authors:
  - family-names: "Madaka"
    given-names: "Pavan Kalyan"

version: "1.0.0"
date-released: "2026-09-05"

repository-code: "https://github.com/MADAKAPAVAN/-AquaTrust"
